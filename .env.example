SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
# Runtime aliases: NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
# Legacy public keys: SUPABASE_ANON_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY.
# For administrative verification scripts only; normal app requests do not use it.
SUPABASE_SECRET_KEY=sb_secret_your-secret-key
SUPABASE_SCHEMA=song_tournament
# For migrations only; keep these out of browser bundles.
DATABASE_URL=postgresql://postgres.your-project:password@your-pooler:5432/postgres
DATABASE_PASSWORD=your-database-password
